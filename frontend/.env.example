# Base path or URL of the API. Keep "/api" when the UI and API share an origin
# (Vite dev proxy, nginx in Docker). Use a full URL for a separately hosted API.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests during development
VITE_DEV_API_PROXY=http://localhost:8000

# Optional: a recorded product video (mp4/webm URL) for the landing page.
# Leave empty to show the built-in interactive product demo.
VITE_DEMO_VIDEO_URL=
