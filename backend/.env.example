# ---------------------------------------------------------------------------
# LegacyNexus AI — backend configuration
# Copy to backend/.env and change every value marked CHANGE ME before production.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# CHANGE ME: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# It signs login tokens and encrypts the AI API keys stored in the database.
SECRET_KEY=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite (default, zero setup) or PostgreSQL for production, e.g.
# DATABASE_URL=postgresql+psycopg://legacynexus:password@localhost:5432/legacynexus
DATABASE_URL=sqlite:///./data/legacynexus.db
STORAGE_DIR=./data/storage

# Upload limits. 0 = unlimited (default). Uploads stream to disk; archives keep only analysable source
# files and skip binaries. Set values only to protect a shared server's disk.
MAX_UPLOAD_MB=0
MAX_EXTRACTED_MB=0
MAX_FILES_PER_PROJECT=0
MAX_FILES_PER_REQUEST=0
MAX_SOURCE_FILE_MB=0

# First-run administrator: created only when the database has no users.
# Demo credentials — CHANGE ME for any shared or production environment.
BOOTSTRAP_ADMIN_EMAIL=admin@legacynexus.ai
BOOTSTRAP_ADMIN_PASSWORD=LegacyNexus@2026
BOOTSTRAP_ADMIN_NAME=Demo Administrator

# Background jobs: inline (run in the API process) or servicebus (Azure Service Bus queue + worker
# containers running `python -m app.worker`). For servicebus set SERVICEBUS_NAMESPACE (managed identity)
# or SERVICEBUS_CONNECTION_STRING, and install requirements-azure.txt.
JOB_BACKEND=inline
SERVICEBUS_QUEUE=analysis-jobs

# Semantic search vector store: auto (pgvector when the database is PostgreSQL with the extension,
# otherwise a local file index), pgvector, or file. The embedding model is chosen in Settings.
VECTOR_STORE=auto
EMBEDDING_REQUEST_TIMEOUT_SECONDS=120

# Q&A defaults (can be changed later in Settings > AI model)
LLM_REQUEST_TIMEOUT_SECONDS=90
QA_TOP_K=8
QA_CONTEXT_CHAR_BUDGET=14000
QA_MIN_RETRIEVAL_SCORE=1.5

# Document Q&A: role-based question answering over a single uploaded PDF/DOCX/TXT/Markdown document.
# Uses the same AI model and (optional) embedding model configured in Settings. All optional.
DOCQA_MAX_FILE_MB=0
DOCQA_CHUNK_CHARS=1200
DOCQA_CHUNK_OVERLAP=150
DOCQA_MAX_CHUNKS=0
DOCQA_TOP_K=6
DOCQA_CONTEXT_CHAR_BUDGET=12000
DOCQA_MIN_CONFIDENCE=0.3

# Document Q&A has its own database and vector store, separate from Code Q&A (DATABASE_URL above).
# Leave unset for the default: SQLite -> data/docqa.db next to the main file; PostgreSQL -> database
# "legacynexus_docqa" on the same server (created automatically if missing). Or set it explicitly:
# DOCQA_DATABASE_URL=sqlite:///./data/docqa.db
# DOCQA_DATABASE_URL=postgresql+psycopg://legacynexus:password@localhost:5432/legacynexus_docqa
# DOCQA_DB_NAME=legacynexus_docqa     # with DB_HOST/DB_USER/DB_PASSWORD; DOCQA_DB_HOST/USER/PASSWORD override
DOCQA_VECTOR_STORE=auto

# Conversations: follow-up questions ("who calls it?", "what about X?") are read against earlier turns.
#   auto = history is used only for follow-ups (no extra tokens for stand-alone questions)
#   always = always send recent history; off = every question stands alone
CONVERSATION_CONTEXT=auto
CONVERSATION_TURNS=4
CONVERSATION_CONTEXT_CHARS=2500

# Optional: AI and embedding models from the environment, applied on start-up only while nothing is set in
# Settings (an administrator's later choice always wins). Example for local Ollama:
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1
# AI_BASE_URL=http://localhost:11434
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://localhost:11434
