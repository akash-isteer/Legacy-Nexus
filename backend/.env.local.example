# ---------------------------------------------------------------------------
# LegacyNexus AI — LOCAL profile
# Copy to backend/.env. Two ways to run locally:
#   1. No Docker:      SQLite file + files on disk (this file as-is), `uvicorn app.main:app --reload`
#   2. docker compose: PostgreSQL + pgvector; docker-compose.yml overrides the DB_* and storage values
# ---------------------------------------------------------------------------
DEPLOYMENT_PROFILE=local
ENVIRONMENT=development

# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz

# Database: SQLite by default. For a local PostgreSQL instead, set DATABASE_URL or the DB_* values:
#   DATABASE_URL=postgresql+psycopg://legacynexus:password@localhost:5432/legacynexus
DATABASE_URL=sqlite:///./data/legacynexus.db      # main: projects, code graph, Code Q&A
DOCQA_DATABASE_URL=sqlite:///./data/docqa.db      # separate: Document Q&A
STORAGE_DIR=./data/storage
VECTOR_STORE=auto            # Code Q&A vectors: file index on SQLite, pgvector on PostgreSQL
DOCQA_VECTOR_STORE=auto      # Document Q&A vectors, kept apart (data/storage/docqa or the docqa database)

# Conversations: follow-ups use earlier turns (auto = only when the question is a follow-up)
CONVERSATION_CONTEXT=auto

# Background jobs run inside the API process
JOB_BACKEND=inline

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173

# Accounts
ALLOW_SIGNUP=true
BOOTSTRAP_ADMIN_EMAIL=admin@legacynexus.ai
BOOTSTRAP_ADMIN_PASSWORD=LegacyNexus@2026
BOOTSTRAP_ADMIN_NAME=Demo Administrator

# Upload limits: 0 = unlimited
MAX_UPLOAD_MB=0
MAX_EXTRACTED_MB=0
MAX_FILES_PER_PROJECT=0
MAX_FILES_PER_REQUEST=0
MAX_SOURCE_FILE_MB=0

# Local AI: point Settings > AI models at Ollama (http://localhost:11434), e.g. llama3.1 + nomic-embed-text,
# or set them here (applied on first start only while Settings has no model):
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1
# AI_BASE_URL=http://localhost:11434
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://localhost:11434
