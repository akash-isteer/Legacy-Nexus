# ---------------------------------------------------------------------------
# LegacyNexus AI — CLOUD profile (Azure). Reference only.
# In Azure these are set on the Container Apps by infra/azure/main.bicep; secrets come from Key Vault.
# Never put real cloud secrets in a file.
# ---------------------------------------------------------------------------
DEPLOYMENT_PROFILE=cloud
ENVIRONMENT=production

SECRET_KEY=<from Key Vault: secret-key>

# Azure Database for PostgreSQL — Flexible Server (pgvector enabled)
DB_HOST=<name>.postgres.database.azure.com
DB_NAME=legacynexus
DB_USER=lnxadmin
DB_PASSWORD=<from Key Vault: db-password>
DB_SSLMODE=require
VECTOR_STORE=pgvector                 # Code Q&A vectors in the main database

# Document Q&A: its own database on the same server (or another one via DOCQA_DB_HOST/USER/PASSWORD)
DOCQA_DB_NAME=legacynexus_docqa
DOCQA_VECTOR_STORE=pgvector           # Document Q&A vectors in the Document Q&A database

CONVERSATION_CONTEXT=auto

# Azure OpenAI (infra/azure/main.bicep sets these when deployOpenAI=true; key from Key Vault)
AI_PROVIDER=azure_openai
AI_BASE_URL=https://<name>.openai.azure.com
AI_DEPLOYMENT=gpt-4o-mini
AI_API_VERSION=2024-10-21
AI_API_KEY=<from Key Vault: ai-api-key>
EMBEDDING_PROVIDER=azure_openai
EMBEDDING_BASE_URL=https://<name>.openai.azure.com
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_API_VERSION=2024-10-21

# Files: an Azure Files share mounted into the containers at /app/data
STORAGE_DIR=/app/data/storage

# Background jobs: Azure Service Bus queue, processed by the worker Container Apps Job
JOB_BACKEND=servicebus
SERVICEBUS_NAMESPACE=<name>.servicebus.windows.net   # managed identity, no keys
SERVICEBUS_QUEUE=analysis-jobs
AZURE_CLIENT_ID=<user-assigned managed identity client id>

CORS_ORIGINS=https://<web app fqdn>
APP_BASE_URL=https://<web app fqdn>

ALLOW_SIGNUP=false            # invite-only for enterprise tenants
BOOTSTRAP_ADMIN_EMAIL=<first admin email>
BOOTSTRAP_ADMIN_PASSWORD=<from Key Vault: bootstrap-admin-password>

# Optional outgoing email for password resets
# SMTP_HOST=smtp.office365.com
# SMTP_USERNAME=...
# SMTP_PASSWORD=<from Key Vault>
